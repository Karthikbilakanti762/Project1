# Copy this file to .env and fill it in. .env is private: never share or commit it.
#
# To switch broker, change these lines only. Nothing else in the app changes.
#
# BROKER        zerodha | upstox | fyers | dhan | angelone
#
#               API_KEY                    API_SECRET              ACCESS_TOKEN
# zerodha       Kite Connect api_key       Kite api_secret         daily token  (python run.py login)
# upstox        app API key                app API secret          daily token  (python run.py login)
# fyers         App ID (ABCD1234-100)      app secret              daily token  (python run.py login)
# dhan          Dhan Client ID             (leave empty)           token from web.dhan.co
# angelone      SmartAPI key               your client code        session JWT  (python run.py login)

BROKER=zerodha
API_KEY=
API_SECRET=
ACCESS_TOKEN=

# Only Upstox and Fyers need this, and only for `python run.py login`:
# the redirect URL you registered on your API app.
REDIRECT_URI=
